<?xml version="1.0"?>
<launch>
  <arg name="sensor_model">
    <choice value="Pandar40P" />
    <choice value="Pandar64" />
    <choice value="Pandar128E4X" />
    <choice value="PandarAT128" />
    <choice value="PandarQT64" />
    <choice value="PandarQT128" />
    <choice value="PandarXT32" />
    <choice value="PandarXT32M" />
  </arg>
  <arg name="launch_hw" default="true" description="Whether to connect to a real sensor (true) or to accept packet messages (false).">
    <choice value="true" />
    <choice value="false" />
  </arg>
  
  <!-- Define separate config files for top and front -->
  <arg name="config_file_for_top_lidar" default="$(find-pkg-share nebula_ros)/config/lidar/hesai/$(var sensor_model).param.top.yaml"/>
  <arg name="config_file_for_front_lidar" default="$(find-pkg-share nebula_ros)/config/lidar/hesai/$(var sensor_model).param.front.yaml"/>

  <!-- Top LiDAR -->
  <node pkg="nebula_ros" exec="hesai_ros_wrapper_node" name="hesai_ros_wrapper_node" namespace="top" output="screen">
    <param from="$(var config_file_for_top_lidar)" allow_substs="true"/>
    <param name="launch_hw" value="$(var launch_hw)"/>
  </node>

  <!-- Front LiDAR -->
  <node pkg="nebula_ros" exec="hesai_ros_wrapper_node" name="hesai_ros_wrapper_node" namespace="front" output="screen">
    <param from="$(var config_file_for_front_lidar)" allow_substs="true"/>
    <param name="launch_hw" value="$(var launch_hw)"/>
  </node>

</launch>
